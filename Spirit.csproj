<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- This project lives at the repo root, so the default **/*.cs glob would
         compile the sibling projects and their generated obj files too. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Spirit.Domain/**;Spirit.Application/**;Spirit.Infrastructure/**;Spirit.Domain.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Spirit.Application\Spirit.Application.csproj" />
    <ProjectReference Include="Spirit.Infrastructure\Spirit.Infrastructure.csproj" />
  </ItemGroup>

</Project>
